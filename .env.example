# Copy this file to .env and adjust the values for your local environment.
# Never commit .env. Never put real secrets in this file.

# Database
POSTGRES_DB=teamos
POSTGRES_USER=teamos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://teamos:change-me@postgres:5432/teamos

# Cache
REDIS_URL=redis://redis:6379/0

# Authentication
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

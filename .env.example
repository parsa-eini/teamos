# Copy this file to .env and adjust the values for your local environment.
# Never commit .env. Never put real secrets in this file.

# Database
POSTGRES_DB=teamos
POSTGRES_USER=teamos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://teamos:change-me@postgres:5432/teamos

# Cache
REDIS_URL=redis://redis:6379/0

# Authentication
# SECRET_KEY must be at least 32 characters.
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend (browser-facing; not secrets)
VITE_API_BASE_URL=http://localhost:8000
VITE_PANEL_URL=http://localhost:5174
VITE_WEBSITE_URL=http://localhost:5173
